{
  "name": "voyager",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "examples": {
        "$className": "Folder",
        "$path": "examples"
      },
      "Voyager Development": {
        "$className": "Script",
        "$properties": {
          "RunContext": "Server"
        }
      }
    },
    "ServerStorage": {
      "voyager": {
        "$className": "Folder",
        "$path": "src/voyager"
      }
    }
  }
}